// Static-assets-only Worker (docs/ARCHITECTURE.md §8.2). Access protects the custom domain and the
// workers.dev previews; configure it in the Zero Trust dashboard, not here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rumah-cici-theia",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "rct.amns.my.id", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": { "enabled": false },
}
