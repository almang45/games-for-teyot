{
  "name": "rumah-cici-theia",
  "private": true,
  "version": "0.0.0",
  "description": "Rumah Cici Theia: an Indonesian learning game for Theia (tracing, counting, reading, coloring).",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/build/check-budget.mjs && node tools/build/check-private.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p src/tsconfig.json && tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "deploy": "npm run validate && npm run build && wrangler deploy",
    "validate": "npm run validate:design && npm run validate:assets",
    "validate:design": "node tools/validate/validate-design.ts",
    "validate:assets": "node tools/validate/validate-assets.ts",
    "contracts:schema": "node tools/validate/write-schemas.ts",
    "house:blockout": "node tools/house/blockout.ts",
    "reference:check": "node tools/inputs/check.ts",
    "reference:frames": "node tools/inputs/frames.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.58.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.165.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true,
    "fsevents": false
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.5",
    "glob@>=9 <=14.0.1": "^14.0.4"
  }
}
